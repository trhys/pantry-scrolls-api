{
    order rate_limit before reverse_proxy
}

localhost {
  handle /api/* {
    rate_limit {
            zone api_limit {
                key {remote_host}
                # Benchmark: Max 10 requests inside a sliding 5-second window (~2 RPS)
                window 5s
                events 10
            }
      }
    reverse_proxy app:8080
  }

  handle {
    reverse_proxy host.docker.internal:5173
  }

  tls internal
}
